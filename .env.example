# Supabase 연동을 위한 환경 변수 — 실제 값은 .env.local에 채우고 커밋하지 마세요.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ⚠️ 서버 전용 (RLS 우회) — 절대 NEXT_PUBLIC_ 접두사를 붙이거나 클라이언트 코드에서 사용하지 마세요.
# 노출되면 DB 전체에 무제한 접근이 가능해집니다. Supabase 대시보드 > Project Settings > API > service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI 견적서 생성기(/tools/quote-generator), 요청서 위저드용 Gemini API 키
# https://aistudio.google.com/apikey 에서 발급 (무료 등급 제공)
GEMINI_API_KEY=your-gemini-api-key

# SEO/GEO 체커 결과 카카오톡 공유 버튼용 JavaScript 키
# https://developers.kakao.com 앱 생성 > 플랫폼에 Web 도메인 등록 후 발급 (카카오 로그인 동의 절차 불필요)
NEXT_PUBLIC_KAKAO_JS_KEY=your-kakao-js-key

# 블로그 발행 -> 채널별 홍보 문구 자동 생성 스크립트(scripts/promo-automation/)용
# 노션 Integration 토큰: https://www.notion.so/my-integrations 에서 발급
NOTION_API_KEY=your-notion-integration-token
# 홍보 문구를 저장할 노션 데이터베이스 ID (데이터베이스 URL의 32자리 문자열)
NOTION_DATABASE_ID=your-notion-database-id
